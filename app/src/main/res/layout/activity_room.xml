<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".RoomActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/rooms_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentInsetEnd="0dp"
            app:contentInsetStart="0dp">

            <include layout="@layout/layout_room_toolbar"/>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_marginTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="100"
        android:gravity="center_horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_1"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="48"
            android:text="@string/action_dummy"
            android:textColor="?android:attr/colorPrimary"
            android:textSize="@dimen/room_action_text_size"
            app:backgroundTint="@android:color/transparent"
            app:rippleColor="#33AAAAAA"
            app:strokeWidth="1dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1.333" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_2"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="48"
            android:text="@string/action_dummy"
            android:textColor="?android:attr/colorPrimary"
            android:textSize="@dimen/room_action_text_size"
            app:backgroundTint="@android:color/transparent"
            app:rippleColor="#33AAAAAA"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="100"
        android:gravity="center_horizontal">

        <com.triggertrap.seekarc.SeekArc
            android:id="@+id/brightness_control"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="center"
            android:padding="50dp"
            app:max="100"
            app:startAngle="30"
            app:sweepAngle="300"
            app:rotation="180"
            app:arcWidth="2dp"
            app:arcColor="?android:attr/textColorSecondary"
            app:progressWidth="6dp"
            app:progressColor="@color/colorPrimary"
            app:roundEdges="true"
            app:thumb="@drawable/ic_circle_outline"
            app:touchInside="true" />

        <com.crystal.crystalrangeseekbar.widgets.CrystalSeekbar
            android:id="@+id/color_control"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            app:corner_radius="10"
            app:min_value="1"
            app:max_value="100"
            app:bar_height="6dp"
            app:bar_color_mode="gradient"
            app:bar_gradient_start="#ff8800"
            app:bar_gradient_end="#eeeeee"
            app:bar_color="?android:attr/textColorSecondary"
            app:bar_highlight_height="6dp"
            app:bar_highlight_color_mode="gradient_partial"
            app:bar_highlight_gradient_start="#ff8800"
            app:bar_highlight_gradient_end="#eeeeee"
            app:thumb_color_match_bar="true"
            app:thumb_diameter="30dp"
            app:data_type="_integer"
            />

    </LinearLayout>

</LinearLayout>